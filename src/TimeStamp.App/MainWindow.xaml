<Window x:Class="TimeStamp.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="타임스탬프 · 순찰 사진 도우미" Width="1320" Height="900" MinWidth="1060" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#F3F6F8" FontFamily="Malgun Gothic" FontSize="13">
  <Grid Background="#F3F6F8" TextElement.Foreground="{StaticResource Ink}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#152D36">
      <Grid Margin="22,30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="◷  TIME STAMP" Foreground="White" FontSize="20" FontWeight="Bold"/><TextBlock Text="순찰 사진 도우미" Foreground="#91AEB7" Margin="0,10,0,36"/></StackPanel>
        <StackPanel Grid.Row="1">
          <Button x:Name="CalcNav" Content="01   순찰 계산기" Click="ShowCalculator" Background="#284750" Foreground="White" HorizontalContentAlignment="Left" Margin="0,0,0,10"/>
          <Button x:Name="StampNav" Content="02   스탬프 찍기" Click="ShowStamp" Background="Transparent" Foreground="#B4C9D0" HorizontalContentAlignment="Left"/>
        </StackPanel>
        <StackPanel Grid.Row="3"><Border Height="1" Background="#35505A" Margin="0,0,0,18"/><TextBlock Text="사진은 이 PC에서만 처리됩니다." Foreground="#A2BBC3" FontSize="11"/><TextBlock Text="5분마다, 빠짐없이." Foreground="#6F939E" FontSize="11" Margin="0,7,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,26,30,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,24">
        <StackPanel><TextBlock x:Name="PageEyebrow" Text="PATROL PLANNER" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="PageTitle" Text="순찰 계산기" FontSize="29" FontWeight="Bold" Margin="0,6,0,7"/><TextBlock x:Name="PageDescription" Text="순찰 시간을 정하면, 필요한 사진 수와 촬영 시각을 계산해 드려요." Foreground="{StaticResource Muted}"/></StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E4EFEB" CornerRadius="20" Padding="13,7"><TextBlock Text="●  5분 간격" Foreground="#237B65" FontSize="11"/></Border>
      </Grid>
      <ScrollViewer x:Name="CalculatorPage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Text="언제 순찰하시나요?" Style="{StaticResource Title}"/>
              <TextBlock Text="날짜는 순찰을 시작하는 날입니다. 종료가 더 이르면 다음 날로 계산해요." Foreground="{StaticResource Muted}" Margin="0,8,0,22"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="순찰 시작일" Style="{StaticResource Label}"/><DatePicker x:Name="CalcDate" SelectedDateFormat="Short" Height="43"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="시작 시각" Style="{StaticResource Label}"/><TextBox x:Name="CalcStart" Text="00:00" MaxLength="5" AutomationProperties.Name="계산기 시작 시각"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="종료 시각" Style="{StaticResource Label}"/><TextBox x:Name="CalcEnd" Text="01:00" MaxLength="5" AutomationProperties.Name="계산기 종료 시각"/></StackPanel>
                <Button Grid.Column="6" Content="계산하기  →" Style="{StaticResource Primary}" VerticalAlignment="Bottom" Height="43" Click="Calculate"/>
              </Grid>
              <WrapPanel Margin="0,18,0,0"><TextBlock Text="간편 계산" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource Muted}" FontSize="12"/><Button Content="00:00 → 00:30" Tag="00:00|00:30" Click="QuickCalculate" Margin="0,0,8,0" Padding="12,8"/><Button Content="00:30 → 01:00" Tag="00:30|01:00" Click="QuickCalculate" Margin="0,0,8,0" Padding="12,8"/><Button Content="00:00 → 01:00" Tag="00:00|01:00" Click="QuickCalculate" Padding="12,8"/></WrapPanel>
              <TextBlock x:Name="CalcWarning" Foreground="#A15C12" Margin="0,14,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
          <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Background="#147D69" CornerRadius="12" Padding="25">
              <StackPanel><TextBlock Text="필요한 사진" Foreground="#CFEBE2"/><StackPanel Orientation="Horizontal" Margin="0,10,0,3"><TextBlock x:Name="CountText" Text="12" FontSize="62" FontWeight="Bold" Foreground="White"/><TextBlock Text="장" Foreground="White" FontSize="21" VerticalAlignment="Bottom" Margin="8,0,0,15"/></StackPanel><TextBlock x:Name="DurationText" Text="총 60분 순찰 · 5분마다 1장" Foreground="#CFEBE2"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="첫 사진은 시작 5분 뒤에" Style="{StaticResource Title}"/><TextBlock x:Name="RuleText" Foreground="{StaticResource Muted}" Margin="0,12,0,14"/><Border Background="#F0F5F7" CornerRadius="7" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="첫 번째 사진" Style="{StaticResource Label}"/><TextBlock x:Name="FirstText" FontSize="24" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="마지막 사진" Style="{StaticResource Label}"/><TextBlock x:Name="LastText" FontSize="24" FontWeight="SemiBold"/></StackPanel></Grid></Border></StackPanel></Border>
          </Grid>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="촬영 타임라인" Style="{StaticResource Title}"/><ItemsControl x:Name="Timeline" Margin="0,16,0,20"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#EFF5F3" CornerRadius="6" Padding="12,8" Margin="0,0,8,8"><TextBlock Text="{Binding}" Foreground="#246E5F"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Height="1" Background="#E5ECEF" Margin="0,0,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="AutoFill" Content="계산한 날짜와 시간을 스탬프 찍기에 자동 입력" IsChecked="True" VerticalAlignment="Center"/><Button Grid.Column="1" Content="스탬프 찍기  →" Style="{StaticResource Primary}" Click="ContinueToStamp"/></Grid></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="StampPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
          <StackPanel><TextBlock Text="1   순찰 시간 입력" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker x:Name="StampDate" Height="41"/><TextBox Grid.Column="2" x:Name="StampStart" Text="00:00" MaxLength="5" AutomationProperties.Name="스탬프 시작 시각"/><TextBox Grid.Column="4" x:Name="StampEnd" Text="01:00" MaxLength="5" AutomationProperties.Name="스탬프 종료 시각"/><Button Grid.Column="6" Content="시간 적용" Style="{StaticResource Primary}" Click="ApplyStampTime"/></Grid>
            <TextBlock x:Name="StampPlanSummary" Margin="0,10,0,0" Foreground="{StaticResource Muted}" FontSize="12"/>
          </StackPanel>
        </Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="225"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*" MinWidth="225"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.2*" MinWidth="240"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="16" AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragOver">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="2   사진 불러오기" FontWeight="SemiBold" FontSize="15"/><StackPanel Grid.Row="1" Margin="0,12,0,10"><Button Content="＋  여러 장 선택" Click="ImportPhotos"/><TextBlock Text="1:1 사진만 가능 · 파일을 여기로 끌어와도 돼요" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
              <ListBox Grid.Row="2" x:Name="PhotoList" SelectionChanged="PhotoSelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Thumbnail}" Width="44" Height="44" Stretch="UniformToFill"/><StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
              <StackPanel Grid.Row="3"><TextBlock x:Name="PhotoCount" Text="사진 0장" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8"/><Button Content="선택한 사진 제외" Click="RemovePhoto" Padding="10,7"/></StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="3   시간에 사진 배치" FontWeight="SemiBold" FontSize="15"/><Grid Grid.Row="1" Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="순서대로" Click="ArrangeSequential" Padding="8,10"/><Button Grid.Column="2" Content="랜덤 배치" Click="ArrangeRandom" Padding="8,10"/></Grid>
              <ListBox x:Name="SlotList" Grid.Row="2" SelectionChanged="SlotSelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding TimeText}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding DayText}" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding PhotoName}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
              <StackPanel Grid.Row="3" Margin="0,10,0,0"><Button Content="선택 사진을 이 시간에 배치 ↓" Style="{StaticResource Primary}" Click="AssignPhoto" Padding="8,10"/><Button Content="이 시간 비우기" Click="ClearSlot" Margin="0,7,0,0" Padding="8,7"/></StackPanel>
            </Grid></Border>
          <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="출력 미리보기" FontWeight="SemiBold" FontSize="15"/><Border Grid.Row="1" Background="#E9EFF1" CornerRadius="7" Margin="0,14,0,12"><Grid><TextBlock x:Name="PreviewPlaceholder" Text="사진과 시간을 선택하면&#10;스탬프를 미리 볼 수 있어요" TextAlignment="Center" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12"/><Image x:Name="PreviewImage" Stretch="Uniform"/></Grid></Border><TextBlock x:Name="PreviewCaption" Grid.Row="2" FontSize="12" Margin="0,0,0,8"/><TextBlock Grid.Row="3" Text="사진 선택 → 시간 선택 → 배치&#10;이미 배치된 사진은 서로 교환됩니다." Foreground="{StaticResource Muted}" FontSize="11"/></Grid></Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="4   스탬프 사진 출력" FontWeight="SemiBold"/><TextBlock x:Name="PlacementSummary" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><ComboBox x:Name="OutputSize" Grid.Column="2" SelectedIndex="0" AutomationProperties.Name="출력 해상도"><ComboBoxItem Content="원본 크기" Tag="0"/><ComboBoxItem Content="1080 × 1080" Tag="1080"/><ComboBoxItem Content="1536 × 1536" Tag="1536"/><ComboBoxItem Content="3240 × 3240" Tag="3240"/></ComboBox><ComboBox x:Name="OutputFormat" Grid.Column="4" SelectedIndex="0" AutomationProperties.Name="출력 형식"><ComboBoxItem Content="JPG · 폴더" Tag="jpg"/><ComboBoxItem Content="PNG · 폴더" Tag="png"/><ComboBoxItem Content="JPG · ZIP" Tag="zip"/></ComboBox><Button x:Name="ExportButton" Grid.Column="6" Content="사진 내보내기  ↗" Style="{StaticResource Primary}" Click="ExportPhotos"/></Grid></Border>
      </Grid>
      <TextBlock x:Name="StatusText" Grid.Row="2" Text="준비 완료 · 모든 시각은 한국 시간 기준입니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/>
    </Grid>
  </Grid>
</Window>
