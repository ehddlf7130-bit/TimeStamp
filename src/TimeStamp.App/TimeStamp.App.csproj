<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>TimeStamp</AssemblyName><RootNamespace>TimeStamp.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="layout-metrics.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="stamp-style.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <ProjectReference Include="../TimeStamp.Core/TimeStamp.Core.csproj" />
    <Content Include="../../handoff/timestamp_codex_handoff/assets/canonical/**/*.png"><Link>Resources/assets/canonical/%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="../../handoff/timestamp_codex_handoff/assets/logo.png"><Link>Resources/assets/logo.png</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="../../handoff/timestamp_codex_handoff/metadata/manifest.json"><Link>Resources/metadata/manifest.json</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="../../handoff/timestamp_codex_handoff/metadata/occurrences.json"><Link>Resources/metadata/occurrences.json</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
</Project>
